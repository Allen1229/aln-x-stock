---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="找不到頁面">
  <div class="text-center py-20">
    <h1 class="text-6xl font-bold text-accent mb-4">404</h1>
    <p class="text-ink-mute mb-6">這個頁面不存在，或已被移除。</p>
    <a href="/" class="inline-block bg-accent hover:bg-accent-hover text-bg font-semibold px-4 py-2 rounded no-underline">回首頁</a>
  </div>
</Layout>
