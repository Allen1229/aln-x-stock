---
import Layout from '@/layouts/Layout.astro';
import { isAdmin } from '@/lib/auth';

export const prerender = false;

if (await isAdmin(Astro)) {
  return Astro.redirect('/admin');
}

const error = Astro.url.searchParams.get('error');
---

<Layout title="管理員登入" noindex>
  <div class="max-w-sm mx-auto mt-12">
    <h1 class="text-2xl font-bold mb-6 text-center">管理員登入</h1>
    <form method="POST" action="/api/admin/login" class="space-y-4 border border-border rounded-lg p-6 bg-bg-card">
      <div>
        <label class="block text-xs text-ink-mute mb-1">密碼</label>
        <input
          type="password"
          name="password"
          required
          autocomplete="current-password"
          class="w-full bg-bg-soft border border-border rounded px-3 py-2 text-ink focus:outline-none focus:border-accent"
        />
      </div>
      {error && <p class="text-up text-sm">{error}</p>}
      <button
        type="submit"
        class="w-full bg-accent hover:bg-accent-hover text-bg font-semibold py-2 rounded transition-colors"
      >
        登入
      </button>
    </form>
  </div>
</Layout>
