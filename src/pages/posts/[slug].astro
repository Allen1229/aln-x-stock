---
import Layout from '@/layouts/Layout.astro';
import AdBanner from '@/components/AdBanner.astro';
import CommentList from '@/components/CommentList.astro';
import CommentForm from '@/components/CommentForm.astro';
import { formatDate } from '@/lib/format';
import { getPostBySlug, parseList, renderMarkdown, incrementViewCount } from '@/lib/posts';
import OutcomeIcon from '@/components/OutcomeIcon.astro';
import { SITE } from '@/config/site';

export const prerender = false;

const { slug } = Astro.params;
const env = Astro.locals.runtime?.env;
const db = env?.DB;

if (!db || !slug) {
  return Astro.redirect('/404');
}

const post = await getPostBySlug(db, slug);
if (!post || post.draft) {
  return Astro.redirect('/404');
}

let viewCount = post.view_count;
try {
  viewCount = await incrementViewCount(db, post.id);
} catch {
  // 累計失敗不影響頁面顯示
}

const html = renderMarkdown(post.body);
const tickers = parseList(post.tickers);

const turnstileSiteKey = env?.TURNSTILE_SITE_KEY;

const publishedISO = new Date(post.published_at * 1000).toISOString();
const modifiedISO = new Date((post.updated_at || post.published_at) * 1000).toISOString();
const postUrl = new URL(`/posts/${post.slug}`, SITE.url).toString();
const articleDescription = post.description || `${post.title} - ${SITE.author}的台股操作紀錄`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: articleDescription,
  url: postUrl,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  inLanguage: 'zh-Hant-TW',
  keywords: [...tickers, ...parseList(post.tags)].join(', '),
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.title,
    url: SITE.url,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  image: new URL(SITE.ogImage, SITE.url).toString(),
};

const r = await db
  .prepare('SELECT id, author, body, created_at FROM comments WHERE post_id = ? ORDER BY created_at DESC')
  .bind(post.id)
  .all<{ id: number; author: string; body: string; created_at: number }>();
const comments = r.results ?? [];
---

<Layout
  title={post.title}
  description={articleDescription}
  ogType="article"
  publishedTime={publishedISO}
  modifiedTime={modifiedISO}
  jsonLd={jsonLd}
>
  <article class="mb-10">
    <header class="mb-6 pb-6 border-b border-border">
      <div class="flex items-start justify-between gap-4 mb-3">
        <h1 class="text-3xl font-bold flex items-center gap-3 flex-wrap min-w-0">
          <span>{post.title}</span>
          {post.outcome && <OutcomeIcon outcome={post.outcome} class="w-7 h-7" withLabel />}
        </h1>
        <span
          class="shrink-0 inline-flex items-center gap-1.5 text-sm text-ink-mute bg-bg-soft border border-border rounded-full px-3 py-1"
          title={`累計 ${viewCount} 次瀏覽`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          {viewCount}
        </span>
      </div>
      <div class="flex items-center gap-3 text-xs text-ink-dim">
        <time>{formatDate(post.published_at * 1000)}</time>
        {tickers.length > 0 && (
          <div class="flex gap-1.5">
            {tickers.map((t) => (
              <span class="px-1.5 py-0.5 rounded bg-bg-soft text-ink-mute">{t}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="prose-article" set:html={html}></div>
  </article>

  <AdBanner />

  <section class="mt-10">
    <h2 class="text-xl font-bold mb-4">留言（{comments.length}）</h2>
    <div class="mb-6">
      <CommentForm postId={post.id} turnstileSiteKey={turnstileSiteKey} />
    </div>
    <CommentList comments={comments} />
  </section>
</Layout>
