---
import Layout from '@/layouts/Layout.astro';
import AdBanner from '@/components/AdBanner.astro';
import Hero from '@/components/Hero.astro';
import PinIcon from '@/components/PinIcon.astro';
import OutcomeIcon from '@/components/OutcomeIcon.astro';
import { formatDate, daysAgo, relativeDateZh } from '@/lib/format';
import { listPosts, parseList } from '@/lib/posts';
import { SITE } from '@/config/site';

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const rawPosts = db ? await listPosts(db) : [];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'zh-Hant-TW',
    publisher: {
      '@type': 'Person',
      name: SITE.author,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: SITE.title,
    url: SITE.url,
    blogPost: rawPosts.slice(0, 10).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.title,
      url: new URL(`/posts/${p.slug}`, SITE.url).toString(),
      datePublished: new Date(p.published_at * 1000).toISOString(),
      description: p.description,
    })),
  },
];

const posts = rawPosts.map((post, i) => {
  const ageDays = daysAgo(post.published_at * 1000);
  const relative = relativeDateZh(post.published_at * 1000);
  return {
    ...post,
    tickerList: parseList(post.tickers),
    ageDays,
    relative,            // 字串（今天/昨天/X 天前），或 null（10+ 天）
    isFresh: ageDays <= 0,
    isRecent: ageDays <= 5,    // NEW 標籤門檻：5 天內
    isIntro: post.is_intro === 1,
    isEven: i % 2 === 0,
  };
});
---

<Layout jsonLd={jsonLd}>
  <Hero />

  <section class="mb-8">
    <h1 class="text-2xl font-bold mb-2">最新文章</h1>
    <p class="text-ink-mute text-sm">個股操作紀錄與心得分享</p>
  </section>

  <div class="space-y-4">
    {posts.map((post, i) => (
      <Fragment>
        <article class:list={[
          'border rounded-lg p-5 transition-colors relative',
          post.isIntro
            ? 'border-amber-400/70 shadow-[0_0_0_1px_rgba(251,191,36,0.18)] hover:border-amber-300 bg-gradient-to-br from-amber-950/25 via-bg-card to-bg-card'
            : post.pinned_at
              ? 'border-accent/60 hover:border-accent bg-bg-card'
              : post.isFresh
                ? 'border-up/60 shadow-[0_0_0_1px_rgba(239,68,68,0.15)] hover:border-up'
                : post.isRecent
                  ? 'border-up/30 hover:border-up'
                  : 'border-border hover:border-accent',
          !post.isIntro && (post.isEven ? 'bg-bg-card' : 'bg-bg-soft'),
        ]}>
          <a href={`/posts/${post.slug}`} class="no-underline block">
            <div class="flex items-start gap-3 mb-2">
              <h2 class="text-xl font-semibold text-ink flex items-start gap-2 min-w-0 flex-1 leading-snug">
                {post.isIntro && (
                  <span class="shrink-0 inline-flex items-center gap-1 text-[10px] font-bold tracking-wider px-1.5 py-0.5 rounded mt-1 bg-amber-400 text-bg">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3">
                      <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8 5.8 21.3l2.4-7.4L2 9.4h7.6z"/>
                    </svg>
                    新手必看
                  </span>
                )}
                {!post.isIntro && post.pinned_at && <PinIcon class="w-5 h-5 shrink-0 mt-0.5" />}
                {!post.isIntro && post.isRecent && (
                  <span class:list={[
                    'shrink-0 inline-flex items-center text-[10px] font-bold tracking-wider px-1.5 py-0.5 rounded mt-1',
                    'bg-up text-white',
                    post.isFresh && 'animate-pulse',
                  ]}>NEW</span>
                )}
                <span class="line-clamp-2 break-words">{post.title}</span>
              </h2>
              {post.outcome && <OutcomeIcon outcome={post.outcome} class="w-5 h-5 shrink-0 mt-1" />}
            </div>
            <div class="flex items-center gap-3 mb-2 flex-wrap">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class:list={['w-4 h-4', post.relative ? 'text-up' : 'text-ink-dim']}>
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {post.relative ? (
                  <Fragment>
                    <span class="text-up font-semibold text-sm">{post.relative}</span>
                    <span class="text-ink-dim text-xs">·</span>
                    <time class="text-ink-dim text-xs">{formatDate(post.published_at * 1000)}</time>
                  </Fragment>
                ) : (
                  <Fragment>
                    <span class="text-ink-dim text-xs px-1.5 py-0.5 rounded bg-bg-soft">較早發布</span>
                    <time class="text-ink-mute text-sm font-medium">{formatDate(post.published_at * 1000)}</time>
                  </Fragment>
                )}
              </div>
              {post.tickerList.length > 0 && (
                <div class="flex gap-1.5">
                  {post.tickerList.map((t) => (
                    <span class="px-1.5 py-0.5 rounded bg-bg-soft text-ink-mute text-xs">{t}</span>
                  ))}
                </div>
              )}
              <div class="flex items-center gap-1.5 ml-auto">
                <span class="inline-flex items-center gap-1 text-xs text-ink-mute bg-bg-soft border border-border rounded-full px-2 py-0.5" title={`累計 ${post.view_count} 次瀏覽`}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  {post.view_count}
                </span>
                <span class="inline-flex items-center gap-1 text-xs text-ink-mute bg-bg-soft border border-border rounded-full px-2 py-0.5" title={`${post.comment_count} 則留言`}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  </svg>
                  {post.comment_count}
                </span>
              </div>
            </div>
            {post.description && (
              <p class="text-ink-mute text-sm leading-relaxed">{post.description}</p>
            )}
          </a>
        </article>
        {(i + 1) % 4 === 0 && i < posts.length - 1 && <AdBanner />}
      </Fragment>
    ))}
    {posts.length === 0 && (
      <div class="text-center text-ink-mute py-12">尚無文章</div>
    )}
  </div>

  {posts.length > 0 && posts.length % 4 !== 0 && <AdBanner />}
</Layout>
