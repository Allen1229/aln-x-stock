---
import { HERO } from '@/config/site';
if (!HERO.enabled) return null;
---

<section class="mb-10 grid grid-cols-1 md:grid-cols-[500px_1fr] gap-6 items-center">
  <div class="rounded-lg overflow-hidden bg-bg-card border border-border w-full md:w-[500px] aspect-[500/460]">
    <img
      src={HERO.imageUrl}
      alt={HERO.imageAlt}
      width="500"
      height="460"
      class="w-full h-full object-cover block"
      loading="eager"
    />
  </div>
  <div>
    <h2 class="text-2xl font-bold text-ink mb-1 leading-snug">{HERO.headline}</h2>
    {HERO.attribution && (
      <p class="text-ink-dim text-sm mb-4">{HERO.attribution}</p>
    )}
    <p class="text-ink-mute text-base leading-relaxed whitespace-pre-line">{HERO.body}</p>
  </div>
</section>
